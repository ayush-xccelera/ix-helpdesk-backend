# PostgreSQL connection string (SQLAlchemy psycopg2 driver)
DATABASE_URL=postgresql+psycopg2://helpdesk:helpdesk@localhost:5432/helpdesk

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# Secret used to sign JWT access tokens — set a long, random value in real deployments
JWT_SECRET=change-me-to-a-long-random-secret

# Optional: if both are set and no admin user exists yet, an admin account is
# bootstrapped at startup. Leave unset to skip admin creation.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated list of allowed CORS origins, or "*" for all
CORS_ORIGINS=*

# Port the API listens on
PORT=8000
